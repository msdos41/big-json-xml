<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BigJsonXml.Desktop"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="BigJsonXml.Desktop.MainWindow"
        x:DataType="local:ViewerModel"
        Title="BigJsonXml"
        Width="1100"
        Height="720">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button Content="Open" Click="OpenClicked"/>
      <Button Content="Find" Click="FindClicked"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
      <ProgressBar Width="120" MinWidth="120" MaxWidth="120" Height="8"
                   Minimum="0" Maximum="1"
                   Value="{Binding ScanFraction}"
                   IsIndeterminate="False"
                   ShowProgressText="False"
                   IsVisible="{Binding ScanFractionShown}"
                   VerticalAlignment="Center"/>
      <TextBlock Text="{Binding RemainingTime}"
                 IsVisible="{Binding RemainingTime, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                 VerticalAlignment="Center"/>
    </StackPanel>
    <local:TabStrip DockPanel.Dock="Top"/>
    <TextBlock DockPanel.Dock="Bottom" Margin="8" Text="{Binding Error}" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <local:DocumentSurface Grid.Row="0" Grid.Column="0"/>
      <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                 AllowAutoHide="False"
                 Minimum="0" Maximum="{Binding ScrollMaxY}"
                 ViewportSize="{Binding ViewportHeight}"
                 Value="{Binding ScrollY, Mode=TwoWay}"/>
      <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                 AllowAutoHide="False"
                 Minimum="0" Maximum="{Binding ScrollMaxX}"
                 ViewportSize="{Binding ViewportWidth}"
                 Value="{Binding ScrollX, Mode=TwoWay}"/>
    </Grid>
  </DockPanel>
</Window>
