<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BigJsonXml.Desktop"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="BigJsonXml.Desktop.MainWindow"
        x:DataType="local:ViewerModel"
        Title="BigJsonXml"
        Width="1100"
        Height="720"
        FontFamily="Segoe UI"
        Background="White">
  <Window.Resources>
    <StreamGeometry x:Key="FolderIcon">M1,4 H6 L8,6 H15 V14 H1 Z</StreamGeometry>
  </Window.Resources>
  <DockPanel>
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="Open" Click="OpenClicked" ToolTip.Tip="Open (Ctrl+O)" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource FolderIcon}" Width="16" Height="16" Stretch="Uniform" Fill="#1F2933" VerticalAlignment="Center"/>
            <TextBlock Text="Open" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="Find" Click="FindClicked" ToolTip.Tip="Find (Ctrl+F)" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Canvas.Left="1" Canvas.Top="1" Width="9" Height="9" Stroke="#1F2933" StrokeThickness="1.5"/>
              <Line StartPoint="8,8" EndPoint="14,14" Stroke="#1F2933" StrokeThickness="1.5"/>
            </Canvas>
            <TextBlock Text="Find" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Border x:Name="TabBand" DockPanel.Dock="Top" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
      <local:TabStrip/>
    </Border>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="24" Background="#F3F4F6" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" BorderBrush="#E1E4E8" BorderThickness="0,0,1,0" Padding="8,0" MinWidth="96">
          <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Column="1" Padding="8,0">
          <TextBlock x:Name="StatusError" Text="{Binding Error}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}"/>
        </Border>
        <StackPanel x:Name="ScanStatus" Grid.Column="2" Orientation="Horizontal" IsVisible="{Binding ScanFractionShown}">
          <Border BorderBrush="#E1E4E8" BorderThickness="1,0,0,0" Padding="8,0"
                  IsVisible="{Binding RemainingTime, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding RemainingTime}" FontSize="12" VerticalAlignment="Center"/>
          </Border>
          <Border BorderBrush="#E1E4E8" BorderThickness="1,0,0,0" Padding="8,0">
            <ProgressBar x:Name="ScanProgress" Width="120" MinWidth="120" MaxWidth="120" Height="8"
                         Minimum="0" Maximum="1"
                         Value="{Binding ScanFraction}"
                         IsIndeterminate="False"
                         ShowProgressText="False"
                         VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <local:DocumentSurface Grid.Row="0" Grid.Column="0"/>
      <Border x:Name="EmptyNotes" Grid.Row="0" Grid.Column="0"
              IsVisible="{Binding ShowEmpty}"
              Background="Transparent"
              ClipToBounds="True"
              Padding="28,24">
        <TextBlock x:Name="Changelog"
                   Text="{x:Static local:EmptyChangelog.Text}"
                   FontFamily="Cascadia Mono, Consolas"
                   FontSize="13"
                   LineHeight="16"
                   Foreground="#1F2933"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>
      </Border>
      <ScrollBar Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                 AllowAutoHide="False"
                 Minimum="0" Maximum="{Binding ScrollMaxY}"
                 ViewportSize="{Binding ViewportHeight}"
                 Value="{Binding ScrollY, Mode=TwoWay}"/>
      <ScrollBar Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                 AllowAutoHide="False"
                 Minimum="0" Maximum="{Binding ScrollMaxX}"
                 ViewportSize="{Binding ViewportWidth}"
                 Value="{Binding ScrollX, Mode=TwoWay}"/>
    </Grid>
  </DockPanel>
</Window>
