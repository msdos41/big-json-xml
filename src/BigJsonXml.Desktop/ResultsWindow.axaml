<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BigJsonXml.Desktop"
        x:Class="BigJsonXml.Desktop.ResultsWindow"
        x:DataType="local:ViewerModel"
        Title="Results"
        Width="440"
        Height="480"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Results" FontWeight="Bold"/>
      <TextBlock Text="{Binding ResultCount}" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="Path" HorizontalAlignment="Right" Margin="0,0,0,4"/>
    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding CurrentResult, Mode=OneWay}" SelectionChanged="ResultSelected">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:FindResult">
          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <TextBlock Text="{Binding Before}"/>
              <TextBlock Text="{Binding Match}" Background="#FFFFF3B0"/>
              <TextBlock Text="{Binding After}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="8,0,0,0"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
