<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BigJsonXml.Desktop"
        x:Class="BigJsonXml.Desktop.FindWindow"
        x:DataType="local:ViewerModel"
        Title="Find"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="Find what"/>
    <TextBox Text="{Binding FindWhat}" PlaceholderText="Find what"/>
    <TextBlock Text="Field name"/>
    <TextBox Text="{Binding FieldName}" PlaceholderText="Field name"/>
    <CheckBox Content="Match case" IsChecked="{Binding MatchCase}"/>
    <CheckBox Content="Element name" IsChecked="{Binding ElementName}"/>
    <CheckBox Content="Attribute name" IsChecked="{Binding AttributeName}"/>
    <CheckBox Content="Value" IsChecked="{Binding Value}"/>
    <CheckBox Content="Start with" IsChecked="{Binding StartsWith}"/>
    <CheckBox Content="Entire cell" IsChecked="{Binding EntireCell}"/>
    <Button Content="Find All" HorizontalAlignment="Left" Click="FindAllClicked"/>
  </StackPanel>
</Window>
